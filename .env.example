# Copy to .env and edit. Never commit the real .env file.
STUDYSYNC_ENV=development            # development | production | testing
STUDYSYNC_SECRET_KEY=change-me-to-a-long-random-string   # REQUIRED in production (python -c "import secrets; print(secrets.token_urlsafe(48))")
STUDYSYNC_DATABASE=studysync.db      # path of the SQLite file
STUDYSYNC_CORS_ORIGINS=http://localhost:5173   # comma-separated list of allowed front-end origins
STUDYSYNC_COOKIE_SECURE=false        # true in production (HTTPS only)
STUDYSYNC_COOKIE_SAMESITE=Lax        # use None (with COOKIE_SECURE=true) when the front end is on another site
STUDYSYNC_TRUST_PROXY=false          # true behind Render/Nginx so the real client IP is used for rate limiting
PORT=5000
